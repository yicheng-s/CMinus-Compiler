// t08: if/if-else/嵌套 — C(IfStmtNode/ElseOpt) D(br/br i1/label)
int main() {
    int x = 10;
    int y = 20;
    int z = 0;
    if (x > 0) {
        z = 1;
    }
    if (x > y) {
        z = 2;
    } else {
        z = 3;
    }
    if (x > 0) {
        if (y > 5) {
            z = z + 10;
        }
    }
    return z;
}
