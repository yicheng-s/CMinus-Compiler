int g_x = 100;
float g_pi = 3.14;
const int SIZE = 10;

int add(int a, int b) {
    return a + b;
}

float mul(float x, float y) {
    return x * y;
}

void doNothing() {
    return;
}

int main() {
    int local1 = 1;
    float local2 = 2.5;
    int result;
    result = add(local1, SIZE);
    if (result > 10) {
        if (local2 != 0.0) {
            result = result - 1;
        }
        return result;
    } else {
        return 0;
    }
}
